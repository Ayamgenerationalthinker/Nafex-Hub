# Database configuration (Neon / PostgreSQL)
DATABASE_URL="postgresql://user:password@host/database"

# Email credentials for Nodemailer (Gmail App Password)
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-app-password"
EMAIL_FROM="onboarding@resend.dev"

# Authentication (Must be a securely generated random string in production)
JWT_SECRET="generate-a-secure-random-string-here"

# Resend API Key (Optional: for transactional emails)
RESEND_API_KEY="re_..."

# EmailJS Configuration (Optional: for client-side/server-side fallback)
EMAILJS_SERVICE_ID="service_..."
EMAILJS_TEMPLATE_ID="template_..."
EMAILJS_PUBLIC_KEY="public_key..."
EMAILJS_PRIVATE_KEY="private_key..."

# Cloudinary Configuration (Optional: for image uploads)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Paystack Configuration (Optional: for payments)
PAYSTACK_SECRET_KEY="sk_test_..."
PAYSTACK_PUBLIC_KEY="pk_test_..."

# Allowed CORS Origins (Comma-separated)
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"
